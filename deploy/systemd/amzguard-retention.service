[Unit]
Description=AMZ Guard evidence retention and permission maintenance

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/amzguard
EnvironmentFile=/etc/amzguard/retention.env
ExecStart=/usr/local/bin/node /opt/amzguard/src/tools/retention.js --apply
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/amzguard/out
ReadOnlyPaths=/opt/amzguard
