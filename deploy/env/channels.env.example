# Install as /etc/amzguard/channels.env (root:root 0600).
DASHBOARD_PUBLIC_URL=https://amzcheck.pc51.com
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
# Optional operations channel: configure both keys or leave both empty.
DINGTALK_OPS_WEBHOOK=
DINGTALK_OPS_SECRET=
# Optional business robot. Webhook only; signing secret may stay empty.
# Page-evidence business alerts only. Collection failures stay on operations.
DINGTALK_BUSINESS_WEBHOOK=
DINGTALK_BUSINESS_SECRET=
# Optional CRM: configure both keys or leave both empty.
CRM_ENDPOINT=
CRM_TOKEN=
