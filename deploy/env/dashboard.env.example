# Install as /etc/amzguard/dashboard.env (root:root 0600).
NODE_ENV=production
HOST=127.0.0.1
PORT=4173
TRUST_PROXY=1
DASHBOARD_USERNAME=admin
# At least 12 characters; use a password-manager generated value.
DASHBOARD_PASSWORD=
# Independent random values, each at least 32 characters.
DASHBOARD_SESSION_SECRET=
AMZGUARD_INGEST_TOKEN=
REPORT_STALE_HOURS=36
COLLECTOR_HEALTH_REQUIRED=1

# Non-secret readiness hints. Dashboard must not receive collector/channel keys.
# Keep CRM at 0 unless both CRM_ENDPOINT and CRM_TOKEN are configured.
AMZGUARD_ZINIAO_CONFIGURED=1
AMZGUARD_DINGTALK_CONFIGURED=1
AMZGUARD_CRM_CONFIGURED=0

# Independent inbound CRM read API; unrelated to outbound CRM_ENDPOINT/CRM_TOKEN.
# Leave ALL fields empty to disable. Provision a new random backend-only token.
AMZGUARD_CRM_CLIENT_ID=
AMZGUARD_CRM_API_TOKEN=
# Comma-separated exact AMZ Guard store keys; never use '*'.
AMZGUARD_CRM_STORE_KEYS=
# Canonical HTTPS origin, e.g. https://amzcheck.pc51.com (no path/query).
AMZGUARD_CRM_PUBLIC_ORIGIN=
# Optional fixed HTTPS CRM backend callback. Empty disables redirect mode only.
AMZGUARD_CRM_CALLBACK_URL=
# 可选：CRM SPA 弹窗免密的单个精确来源，可明确配置 http://amzcrm.pc51.com。
# 不含路径、尾斜杠、query 或 fragment；此配置不放宽监测站 HTTPS 要求。
AMZGUARD_CRM_BRIDGE_ORIGIN=
