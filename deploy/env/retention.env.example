# Install as /etc/amzguard/retention.env (root:root 0600).
AMZGUARD_EVIDENCE_RETENTION_DAYS=45
AMZGUARD_REPORT_RETENTION_DAYS=365
AMZGUARD_LOG_RETENTION_DAYS=60
AMZGUARD_AUDIT_RETENTION_DAYS=365
# Uploaded business files are more sensitive than result metadata. Records and
# audit stay under the audit limit; payload bytes are removed much sooner.
AMZGUARD_UPLOAD_PAYLOAD_RETENTION_DAYS=7
