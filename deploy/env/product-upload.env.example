# Install as /etc/amzguard/product-upload.env (root:root 0600).
# Both gates default to off. Enabling them authorizes only the dedicated,
# user-confirmed Seller Central bulk product upload path.
AMZGUARD_PRODUCT_UPLOAD_ENABLED=0
AMZGUARD_PRODUCT_UPLOAD_EXECUTION_ENABLED=0
# Must exactly match an enabled Dashboard admin in the user database at startup.
# The Linux installer additionally requires it to equal DASHBOARD_USERNAME.
AMZGUARD_PRODUCT_UPLOAD_ADMIN_USERNAME=
AMZGUARD_PRODUCT_UPLOAD_CLAMSCAN_PATH=/usr/bin/clamscan
AMZGUARD_PRODUCT_UPLOAD_SIGNATURE_MAX_AGE_DAYS=7
